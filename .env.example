# =========================================================
# FOMO Alpha Scanner Configuration
# =========================================================

# FOMO API Key (Obtain from https://fomoapi.io/dashboard)
# Note: When left empty or undefined, the application operates in High-Fidelity Simulation / Demo Mode.
FOMO_API_KEY=

# Base URL for FOMO API
FOMO_BASE_URL=https://api.fomoapi.io
FOMO_WS_URL=wss://api.fomoapi.io/ws/alerts

# Database Connection URL
# SQLite default for local zero-config: file:./dev.db
# PostgreSQL for production: postgresql://postgres:postgres@localhost:5432/fomo_alpha?schema=public
DATABASE_URL="file:./dev.db"

# Execution Mode: PAPER | MANUAL | LIVE
# Default: PAPER (LIVE mode strictly requires manual approval and is locked by default)
EXECUTION_MODE=PAPER

# Telegram Alert Configuration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Node Environment
NODE_ENV=development
